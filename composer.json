{
    "name": "dept-of-scrapyard-robotics/seesaw-mini-gamepad",
    "description": "Read the Adafruit Mini I2C Gamepad (seesaw) over I2C with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "seesaw",
        "gamepad",
        "joystick",
        "adafruit",
        "i2c",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/i2c": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/io-pools": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - IRQ interrupt pin",
        "gpio/i2c": "^0.10.0 - I2C connections for SeesawI2CTransport",
        "venusian-voyager/io-pools": "^0.10.0 - the event loop every() polls on",
        "microscrap/scrapyard-linux": "^0.10.0 - native i2c-dev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE I2C and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawMiniGamepad\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawMiniGamepad\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Actuators\\SeesawMiniGamepad\\Providers\\SeesawMiniGamepadServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
